// # https://zed.dev/docs/configuring-zed
{
	"agent_servers": {
  "claude-acp": {
   "type": "registry"
  }
 },
 "project_panel": {
  "dock": "left"
 },
 "outline_panel": {
  "dock": "left"
 },
 "collaboration_panel": {
  "dock": "left"
 },
 "agent": {
  "dock": "right",
  "favorite_models": [],
  "model_parameters": []
 },
 "git_panel": {
  "dock": "left"
 },
 "icon_theme": "Catppuccin Macchiato",
	"base_keymap": "VSCode",
	"theme": "Carbonfox",
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"preview_tabs": {
		"enabled": false,
	},
	"show_whitespaces": "all",
	"hard_tabs": true,
	"formatter": "language_server",
	"languages": {
		"JavaScript": {
			"formatter": "prettier",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
		"TypeScript": {
			"formatter": "prettier",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
	},
}
