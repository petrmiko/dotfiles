{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {"top": 1, "right": 4}
  },
  "display": {
    "separator": "  ",
    "key": {"width": 14},
    "color": {"keys": "blue", "title": "1;35", "separator": "90"},
    "bar": {"char": {"elapsed": "■", "total": "·"}, "width": 12, "border": {"left": "", "right": ""}, "color": {"total": "90"}},
    "percent": {"type": 3, "color": {"green": "green", "yellow": "yellow", "red": "red"}}
  },
  "modules": [
    "title",
    {"type": "separator", "string": "─"},

    {"type": "os",       "key": "  os",       "keyColor": "magenta"},
    {"type": "host",     "key": "󰌢  host",     "keyColor": "magenta"},
    {"type": "kernel",   "key": "  kernel",   "keyColor": "magenta"},

    "break",
    {"type": "shell",    "key": "  shell",    "keyColor": "cyan"},
    {"type": "packages", "key": "󰏖  packages", "keyColor": "cyan"},
    {"type": "terminal", "key": "  terminal", "keyColor": "cyan"},

    "break",
    {"type": "cpu",      "key": "  cpu",      "keyColor": "green"},
    {"type": "gpu",      "key": "󰢮  gpu",      "keyColor": "green"},
    {"type": "memory",   "key": "󰍛  memory",   "keyColor": "green"},
    {"type": "cpuusage", "key": "󰓅  usage",    "keyColor": "green"},
    {"type": "loadavg",  "key": "󰊚  load",     "keyColor": "green"},

    "break",
    {"type": "localip",  "key": "󰩟  local ip", "keyColor": "blue"},
    {"type": "dns",      "key": "󰖟  dns",      "keyColor": "blue"},

    "break",
    {"type": "battery",      "key": "󰁹  battery", "keyColor": "yellow"},
    {"type": "poweradapter", "key": "󰚥  power",   "keyColor": "yellow"}
  ]
}
